@model ResultFormViewModel

<div class="mb-3">
    <label asp-for="FinishTime" class="form-label"></label>
    <input asp-for="FinishTime" class="form-control" type="text" placeholder="00:48:32"
           autocomplete="off" />
    <div class="form-text">Use hh:mm:ss, e.g. 00:48:32 or 02:15:07.</div>
    <span asp-validation-for="FinishTime" class="text-danger small"></span>
</div>

<div class="mb-3">
    <label asp-for="Position" class="form-label"></label>
    <input asp-for="Position" class="form-control" type="number" min="1" />
    <span asp-validation-for="Position" class="text-danger small"></span>
</div>
