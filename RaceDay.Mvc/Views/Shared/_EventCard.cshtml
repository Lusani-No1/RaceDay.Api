@model EventDto
@{
    var banner = ApiUrl.Resolve(Model.BannerUrl);
    if (string.IsNullOrWhiteSpace(banner))
        banner = ApiUrl.Resolve(ViewHelpers.DefaultBanner(Model.EventId));
    var isPast = Model.EventDate < DateOnly.FromDateTime(DateTime.Today);
}
<article class="card rd-event-card h-100">
    <div class="rd-card-media">
        @if (!string.IsNullOrWhiteSpace(banner))
        {
            <img src="@banner" alt="@Model.Name banner" loading="lazy" />
        }
        else
        {
            <div class="rd-card-placeholder"><span>@ViewHelpers.EventTypeIcon(Model.EventType)</span></div>
        }
        <span class="badge rd-type-badge">@ViewHelpers.EventTypeIcon(Model.EventType) @Model.EventType</span>
        @if (isPast)
        {
            <span class="badge bg-dark rd-past-badge">Completed</span>
        }
    </div>
    <div class="card-body d-flex flex-column">
        <h3 class="h5 mb-1">@Model.Name</h3>
        <p class="text-muted small mb-2">
            <span class="me-2">@Model.EventDate.ToString("ddd, dd MMM yyyy")</span>
            <span class="me-2">·</span>
            <span>@Model.Location</span>
        </p>
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p class="small text-secondary rd-clamp">@Model.Description</p>
        }
        <div class="mt-auto d-flex justify-content-between align-items-center pt-2">
            <span class="fw-semibold">@Model.DistanceKm.ToString("0.##") km</span>
            <a class="btn btn-sm btn-primary" asp-controller="Events" asp-action="Details" asp-route-id="@Model.EventId">View event</a>
        </div>
    </div>
</article>
