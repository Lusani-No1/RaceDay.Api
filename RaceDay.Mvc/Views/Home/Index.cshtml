@model EventListViewModel
@{
    ViewData["Title"] = "Home";
    var types = new[] { "All", "Run", "Walk", "Cycle" };
    var hasEvents = Model.Events.Count > 0;
}

<section class="rd-hero rd-fade-in">
    <div class="row align-items-center g-4">
        <div class="col-lg-8">
            <div class="rd-kicker mb-2">South African road running · walking · cycling</div>
            <h1 class="display-5 mb-3">Find your next start line.</h1>
            <p class="lead mb-0">
                Browse upcoming events, pick a category and lock in your entry.
                Your results and race history live here too.
            </p>
        </div>
        <div class="col-lg-4 text-lg-end">
            <a class="btn btn-primary btn-lg" asp-controller="Enrolments" asp-action="Index">
                My enrolments
            </a>
        </div>
    </div>
</section>

<form class="rd-filter-bar mb-4" method="get" asp-action="Index">
    <div class="row g-2 align-items-end">
        <div class="col-lg-5">
            <label class="form-label small fw-semibold" for="search">Search</label>
            <input id="search" name="search" value="@Model.Search" class="form-control"
                   placeholder="Event name or location" />
        </div>
        <div class="col-lg-3">
            <label class="form-label small fw-semibold" for="type">Type</label>
            <select id="type" name="type" class="form-select">
                @foreach (var option in types)
                {
                    <option value="@option" selected="@(Model.Type == option || (string.IsNullOrEmpty(Model.Type) && option == "All"))">@option</option>
                }
            </select>
        </div>
        <div class="col-lg-2">
            <button type="submit" class="btn btn-primary w-100">Filter</button>
        </div>
        <div class="col-lg-2">
            <a class="btn btn-outline-secondary w-100" asp-action="Index">Reset</a>
        </div>
    </div>
</form>

<div class="d-flex justify-content-between align-items-end mb-3">
    <div>
        <h2 class="h3 rd-section-title mb-0">Upcoming events</h2>
        <p class="text-muted mb-0 small">Soonest first — @Model.Events.Count event(s)</p>
    </div>
</div>

@if (hasEvents)
{
    <div class="row g-4">
        @foreach (var ev in Model.Events)
        {
            <div class="col-md-6 col-xl-4">
                <partial name="_EventCard" model="ev" />
            </div>
        }
    </div>
}
else
{
    <div class="rd-empty-state">
        <h3 class="h4">No events match your filters</h3>
        <p class="text-muted mb-3">Try a different search term or event type.</p>
        <a class="btn btn-outline-primary" asp-action="Index">Show all upcoming events</a>
    </div>
}
