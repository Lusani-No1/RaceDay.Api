@model CategoryFormViewModel
@{
    ViewData["Title"] = "Edit category";
}

<a class="d-inline-block mb-3 small fw-semibold" asp-action="Index" asp-route-eventId="@Model.EventId">
    ← Back to categories
</a>

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <h1 class="h3 rd-section-title mb-1">Edit category</h1>
        <p class="text-muted mb-4">@Model.EventName</p>

        <form method="post" asp-action="Edit" asp-route-eventId="@Model.EventId" asp-route-id="@Model.CategoryId">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
            <input type="hidden" asp-for="EventId" />
            <input type="hidden" asp-for="CategoryId" />
            <partial name="_Form" model="Model" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save changes</button>
                <a class="btn btn-outline-secondary" asp-action="Index" asp-route-eventId="@Model.EventId">Cancel</a>
            </div>
        </form>
    </div>
</div>
