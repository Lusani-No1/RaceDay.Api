@model List<CategoryDto>
@{
    var ev = ViewData["Event"] as EventDto;
    ViewData["Title"] = "Categories";
}

@if (ev is not null)
{
    <a class="d-inline-block mb-3 small fw-semibold" asp-controller="OrganiserEvents" asp-action="Index">
        ← Back to my events
    </a>
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <div class="rd-kicker">Categories</div>
        <h1 class="h2 rd-section-title mb-1">@(ev?.Name ?? "Event categories")</h1>
        <p class="text-muted mb-0">Distances and age groups participants can enter.</p>
    </div>
    @if (ev is not null)
    {
        <a class="btn btn-primary" asp-action="Create" asp-route-eventId="@ev.EventId">Add category</a>
    }
</div>

@if (Model.Count == 0)
{
    <div class="rd-empty-state">
        <h3 class="h4">No categories yet</h3>
        <p class="text-muted mb-3">Participants cannot enter this event until at least one category exists.</p>
        @if (ev is not null)
        {
            <a class="btn btn-primary" asp-action="Create" asp-route-eventId="@ev.EventId">Add the first category</a>
        }
    </div>
}
else
{
    <div class="rd-table">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Category</th>
                    <th>Distance</th>
                    <th>Age range</th>
                    <th>Entry fee</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var category in Model)
                {
                    <tr>
                        <td class="fw-semibold">@category.Name</td>
                        <td>@(category.DistanceKm is null ? "—" : $"{category.DistanceKm:0.##} km")</td>
                        <td>
                            @if (category.MinAge is null && category.MaxAge is null)
                            {
                                <span>Open</span>
                            }
                            else if (category.MinAge is not null && category.MaxAge is not null)
                            {
                                <span>@category.MinAge–@category.MaxAge</span>
                            }
                            else if (category.MinAge is not null)
                            {
                                <span>@category.MinAge+</span>
                            }
                            else
                            {
                                <span>Up to @category.MaxAge</span>
                            }
                        </td>
                        <td>R @category.Price.ToString("0.00")</td>
                        <td class="text-end">
                            @if (ev is not null)
                            {
                                <div class="d-flex flex-wrap justify-content-end gap-1">
                                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit"
                                       asp-route-eventId="@ev.EventId" asp-route-id="@category.CategoryId">Edit</a>
                                    <form method="post" asp-action="Delete" asp-route-eventId="@ev.EventId"
                                          asp-route-id="@category.CategoryId" class="d-inline"
                                          onsubmit="return confirm('Delete @category.Name?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                </div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
