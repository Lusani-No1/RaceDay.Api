@model EventEnrolmentsViewModel
@{
    ViewData["Title"] = "Enrolments";
    var confirmed = Model.Enrolments.Count(e => e.Status == "Confirmed");
    var pending = Model.Enrolments.Count(e => e.Status == "Pending");
    var cancelled = Model.Enrolments.Count(e => e.Status == "Cancelled");
}

<a class="d-inline-block mb-3 small fw-semibold" asp-controller="OrganiserEvents" asp-action="Index">
    ← Back to my events
</a>

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <div class="rd-kicker">Entries</div>
        <h1 class="h2 rd-section-title mb-1">@Model.Event.Name</h1>
        <p class="text-muted mb-0">
            @Model.Event.EventDate.ToString("dd MMM yyyy") · @Model.Event.Location
        </p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" asp-controller="OrganiserResults" asp-action="Index"
           asp-route-eventId="@Model.Event.EventId">Capture results</a>
        <a class="btn btn-outline-secondary" asp-controller="Events" asp-action="Details"
           asp-route-id="@Model.Event.EventId">View event page</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="rd-stat-card">
            <div class="rd-stat-value">@Model.Enrolments.Count</div>
            <div class="rd-stat-label">Total entries</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="rd-stat-card">
            <div class="rd-stat-value">@confirmed</div>
            <div class="rd-stat-label">Confirmed</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="rd-stat-card">
            <div class="rd-stat-value">@pending</div>
            <div class="rd-stat-label">Pending</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="rd-stat-card">
            <div class="rd-stat-value">@cancelled</div>
            <div class="rd-stat-label">Cancelled</div>
        </div>
    </div>
</div>

@if (Model.Enrolments.Count == 0)
{
    <div class="rd-empty-state">
        <h3 class="h4">No enrolments yet</h3>
        <p class="text-muted mb-0">Entries will appear here as participants sign up.</p>
    </div>
}
else
{
    <div class="rd-table">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Participant</th>
                    <th>Category</th>
                    <th>Enrolled on</th>
                    <th>Status</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var enrolment in Model.Enrolments.OrderBy(e => e.CategoryName).ThenBy(e => e.ParticipantName))
                {
                    <tr>
                        <td class="fw-semibold">@enrolment.ParticipantName</td>
                        <td>@enrolment.CategoryName</td>
                        <td class="text-muted small">@enrolment.EnrolmentDate.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                        <td>
                            <span class="badge @ViewHelpers.StatusBadge(enrolment.Status)">@enrolment.Status</span>
                        </td>
                        <td class="text-end">
                            @if (enrolment.Status == "Confirmed")
                            {
                                <a class="btn btn-sm btn-outline-primary" asp-controller="OrganiserResults"
                                   asp-action="Capture" asp-route-eventId="@Model.Event.EventId"
                                   asp-route-enrolmentId="@enrolment.EnrolmentId">Capture result</a>
                            }
                            else
                            {
                                <span class="text-muted small">—</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
