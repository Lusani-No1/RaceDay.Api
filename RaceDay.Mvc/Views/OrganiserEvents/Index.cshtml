@model List<EventDto>
@{
    ViewData["Title"] = "My events";
    var today = DateOnly.FromDateTime(DateTime.Today);
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <div class="rd-kicker">Organiser</div>
        <h1 class="h2 rd-section-title mb-1">My events</h1>
        <p class="text-muted mb-0">Create, edit and manage the events you own.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">Create event</a>
</div>

@if (Model.Count == 0)
{
    <div class="rd-empty-state">
        <h3 class="h4">No events yet</h3>
        <p class="text-muted mb-3">Your first event is only a few details away.</p>
        <a class="btn btn-primary" asp-action="Create">Create an event</a>
    </div>
}
else
{
    <div class="rd-table">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Event</th>
                    <th>Date</th>
                    <th>Distance</th>
                    <th>Type</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ev in Model)
                {
                    <tr>
                        <td>
                            <a class="fw-semibold" asp-controller="Events" asp-action="Details"
                               asp-route-id="@ev.EventId">@ev.Name</a>
                            <div class="text-muted small">@ev.Location</div>
                        </td>
                        <td>@ev.EventDate.ToString("dd MMM yyyy")</td>
                        <td>@ev.DistanceKm.ToString("0.##") km</td>
                        <td>@ViewHelpers.EventTypeIcon(ev.EventType) @ev.EventType</td>
                        <td>
                            @if (ev.EventDate >= today)
                            {
                                <span class="badge bg-success">Upcoming</span>
                            }
                            else
                            {
                                <span class="badge bg-dark">Completed</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-flex flex-wrap justify-content-end gap-1">
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit"
                                   asp-route-id="@ev.EventId">Edit</a>
                                <a class="btn btn-sm btn-outline-secondary" asp-controller="OrganiserCategories"
                                   asp-action="Index" asp-route-eventId="@ev.EventId">Categories</a>
                                <a class="btn btn-sm btn-outline-secondary" asp-controller="OrganiserEnrolments"
                                   asp-action="Index" asp-route-eventId="@ev.EventId">Enrolments</a>
                                <a class="btn btn-sm btn-outline-secondary" asp-controller="OrganiserResults"
                                   asp-action="Index" asp-route-eventId="@ev.EventId">Results</a>
                                <form method="post" asp-action="Delete" asp-route-id="@ev.EventId" class="d-inline"
                                      onsubmit="return confirm('Delete @ev.Name? This also removes its categories, enrolments and results.');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
