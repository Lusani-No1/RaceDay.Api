@model EventFormViewModel
@{
    ViewData["Title"] = "Edit event";
}

<a class="d-inline-block mb-3 small fw-semibold" asp-action="Index">← Back to my events</a>

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <h1 class="h3 rd-section-title mb-1">Edit event</h1>
        <p class="text-muted mb-4">Update the event details or replace its banner image.</p>

        <form method="post" asp-action="Edit" asp-route-id="@Model.EventId" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
            <input type="hidden" asp-for="EventId" />
            <partial name="_Form" model="Model" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save changes</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</div>
