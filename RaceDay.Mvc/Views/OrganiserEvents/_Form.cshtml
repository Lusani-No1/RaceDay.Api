@model EventFormViewModel
@{
    var isEdit = Model.EventId is not null;
    var currentBanner = isEdit ? ApiUrl.Resolve(Model.ExistingBannerUrl) : string.Empty;
    var types = new[] { "Run", "Walk", "Cycle" };
}

<div class="mb-4">
    <div class="rd-kicker">Event details</div>
    <label asp-for="Name" class="form-label">Event name</label>
    <input asp-for="Name" class="form-control" placeholder="e.g. Coastal Half Marathon" />
    <span asp-validation-for="Name" class="text-danger small"></span>
</div>

<div class="mb-4">
    <label asp-for="Description" class="form-label"></label>
    <textarea asp-for="Description" class="form-control" rows="4"
              placeholder="Describe the route, start times and anything participants need to know."></textarea>
    <span asp-validation-for="Description" class="text-danger small"></span>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <label asp-for="EventDate" class="form-label"></label>
        <input asp-for="EventDate" class="form-control" type="date" />
        <span asp-validation-for="EventDate" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Location" class="form-label"></label>
        <input asp-for="Location" class="form-control" placeholder="e.g. Sea Point Promenade, Cape Town" />
        <span asp-validation-for="Location" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="DistanceKm" class="form-label"></label>
        <input asp-for="DistanceKm" class="form-control" type="number" step="0.01" min="0.01" />
        <span asp-validation-for="DistanceKm" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="EventType" class="form-label"></label>
        <select asp-for="EventType" class="form-select">
            @foreach (var type in types)
            {
                <option value="@type">@type</option>
            }
        </select>
        <span asp-validation-for="EventType" class="text-danger small"></span>
    </div>
</div>

<div class="mb-4">
    <label asp-for="Banner" class="form-label"></label>
    <input asp-for="Banner" class="form-control" type="file" accept="image/jpeg,image/png,image/webp" />
    <div class="form-text">JPEG, PNG or WebP · up to 5 MB. Stored through the RaceDay API.</div>
    <span asp-validation-for="Banner" class="text-danger small"></span>

    @if (!string.IsNullOrWhiteSpace(currentBanner))
    {
        <div class="mt-3">
            <div class="text-muted small mb-2">Current banner</div>
            <img src="@currentBanner" alt="Current event banner" class="rd-detail-banner"
                 style="max-height: 200px;" />
        </div>
    }
</div>
