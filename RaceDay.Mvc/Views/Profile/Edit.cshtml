@model EditProfileViewModel
@{
    ViewData["Title"] = "Edit profile";
}

<a class="d-inline-block mb-3 small fw-semibold" asp-action="Index">← Back to profile</a>

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <h1 class="h3 rd-section-title mb-1">Edit profile</h1>
        <p class="text-muted mb-4">Keep your contact details up to date for race day.</p>

        <form method="post" asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="FullName" class="form-label"></label>
                    <input asp-for="FullName" class="form-control" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="PhoneNumber" class="form-label"></label>
                    <input asp-for="PhoneNumber" class="form-control" placeholder="0821234567" />
                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="DateOfBirth" class="form-label"></label>
                    <input asp-for="DateOfBirth" class="form-control" type="date" />
                    <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="EmergencyContact" class="form-label"></label>
                    <input asp-for="EmergencyContact" class="form-control" placeholder="Name and phone number" />
                    <span asp-validation-for="EmergencyContact" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="ProfileImageUrl" class="form-label"></label>
                    <input asp-for="ProfileImageUrl" class="form-control" placeholder="Leave blank to upload a picture instead" />
                    <span asp-validation-for="ProfileImageUrl" class="text-danger small"></span>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">Save changes</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</div>
